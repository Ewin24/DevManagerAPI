{
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=GestionHumanaSolidaria;TrustServerCertificate=true;User Id=sa;Password={{PLACEHOLDER_DB_PASSWORD}};MultipleActiveResultSets=true"
  },
  "JwtSettings": {
    "SecretKey": "{{PLACEHOLDER_JWT_SECRET_KEY_AT_LEAST_32_CHARS}}",
    "Issuer": "GestionHumanaSolidaria",
    "Audience": "GestionHumanaSolidaria",
    "ExpirationInMinutes": 60
  },
  "GeminiSettings": {
    "ApiKey": "{{PLACEHOLDER_GEMINI_API_KEY}}",
    "Model": "gemini-2.5-flash",
    "MaxTokens": 1024,
    "Temperature": 0.7
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "File", "Args": { "path": "logs/api-.log", "rollingInterval": "Day" } }
    ]
  },
  "AllowedHosts": "*"
}
